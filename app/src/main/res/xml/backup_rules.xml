<?xml version="1.0" encoding="utf-8"?>
<!--
  Respaldo automático de Google en Android 11 y anteriores.

  Los vídeos quedan fuera: son cien y pico megas que se recuperan con una descarga, y el
  respaldo tiene un tope de 25 MB por app. Si se pasa, Google descarta la copia ENTERA,
  y con ella el historial de entrenamientos, que es lo único aquí que no se recupera solo.

  master_auth.xml queda fuera porque guarda la sesión del entrenador. Un refresh token
  restaurado en otro teléfono es permiso de escritura sobre los perfiles de todos.
-->
<full-backup-content>
    <exclude domain="file" path="videos/" />
    <exclude domain="sharedpref" path="master_auth.xml" />
</full-backup-content>
