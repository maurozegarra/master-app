<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 en adelante. Mismo criterio que backup_rules.xml, en los dos destinos:

  - cloud-backup: el tope de 25 MB haría que 110 MB de vídeo tiraran la copia entera,
    historial incluido.
  - device-transfer: al cambiar de teléfono tampoco tiene sentido mover vídeos que el
    app vuelve a bajar del manifiesto en cuanto haga falta.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="videos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="videos/" />
    </device-transfer>
</data-extraction-rules>
